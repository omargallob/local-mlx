# Copy to compose.env and edit. compose.env is gitignored.

# Address of the Mac's mlx_lm.server on your LAN (find with `ipconfig getifaddr en0` on the Mac).
MLX_HOST=192.168.1.50:8080

# Optional: pin a model. If unset, the server's first model is used.
# MLX_MODEL=mlx-community/Qwen3-4B-Instruct-2507-8bit
